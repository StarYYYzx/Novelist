# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Novelist 工作区数据（演示/生成物不入库）
*.index.db
demo/
# 排除工作区生成数据，但保留端到端测试脚本与测试报告（测试资产需可复现）
novel_workspace/*
!novel_workspace/_harness/

# 会话记忆（本项目工作日志，非源码）
.workbuddy/

# WorkBuddy 桌面端话题元数据（会话管理自动产物，非源码）
.reasonix/

# AutoDL 云端 SSH 凭据（含明文密码，绝不入库）
novel_workspace/_harness/autodl_ssh.txt

# v5/v6/v7 运行产物（锁与日志不入库）
novel_workspace/_harness/.v5.lock
novel_workspace/_harness/run_v5_log.jsonl
novel_workspace/_harness/run_v6_log.jsonl
novel_workspace/_harness/run_v7_log.jsonl
novel_workspace/_harness/run_t5_log.jsonl

# docx 互转样例产物（演示用，非源码）
novel_workspace/_harness/docx_sample/

# 用户手稿测试目录（test_noval 为用户亲手写的测试稿，只读不提交）
tests/test_noval/

# 探针运行产物（可重跑再生，只提交探针脚本与报告）
novel_workspace/_harness/.probe_castings/

# 早期 desktop 原型试水产物（暂缓，待基本功能设计完成后重启；本地保留不入库）
screen1.png
*.png

# 缓存
.pytest_cache/

# DeepSeek API key（明文，绝不入库）
novel_workspace/_harness/.deepseek_key

# 多服务商 API key 集中存放（方案 A，明文；一行 KEY=VAL，绝不入库）
# 搜索路径见 providers/secrets.py load_env_files
novel_workspace/.env
.env

# 新书 5 章测试运行日志
novel_workspace/_harness/firstbook5_log.jsonl

# 云端五章（cloud5）运行日志（可重跑再生，不入库）
novel_workspace/_harness/cloud5_*.log
novel_workspace/_harness/cloud5_*.jsonl
novel_workspace/_harness/cloud5_*.txt
.git_wiped_20260905/

# 云端 B 服务器（cloudb5）运行日志
