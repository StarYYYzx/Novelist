# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Novelist 工作区数据（演示/生成物不入库）
*.index.db
demo/
# 排除工作区生成数据，但保留端到端测试脚本与测试报告（测试资产需可复现）
novel_workspace/*
!novel_workspace/_harness/

# 会话记忆（本项目工作日志，非源码）
.workbuddy/

# WorkBuddy 桌面端话题元数据（会话管理自动产物，非源码）
.reasonix/

# AutoDL 云端 SSH 凭据（含明文密码，绝不入库）
novel_workspace/_harness/autodl_ssh.txt

# v5/v6/v7 运行产物（锁与日志不入库）
novel_workspace/_harness/.v5.lock
novel_workspace/_harness/run_v5_log.jsonl
novel_workspace/_harness/run_v6_log.jsonl
novel_workspace/_harness/run_v7_log.jsonl
novel_workspace/_harness/run_t5_log.jsonl

# docx 互转样例产物（演示用，非源码）
novel_workspace/_harness/docx_sample/
