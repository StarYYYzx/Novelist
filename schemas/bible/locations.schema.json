{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelist.dev/schemas/bible/locations.schema.json",
  "title": "location",
  "description": "地点/地图（设定圣经）。见 docs/06 §2。",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string", "pattern": "^loc:[A-Za-z0-9_-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "parent": { "type": ["string", "null"], "pattern": "^loc:[A-Za-z0-9_-]+$" },
    "desc": { "type": "string" },
    "status": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
