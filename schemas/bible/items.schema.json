{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelist.dev/schemas/bible/items.schema.json",
  "title": "ItemRegistryEntry",
  "description": "物品注册表条目（游戏式资产登记）。物品 = 可持有的实体（丹药/灵石/法器/杂物）。功法见 skills.json。 F0': 根节点修正为数组（磁盘实然，docs/06 §3 数组形态）。",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "type"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^item:"
      },
      "name": {
        "type": "string",
        "description": "规范名（正文与 worldstate 一律使用此名）"
      },
      "type": {
        "type": "string",
        "enum": [
          "consumable",
          "equipment",
          "artifact",
          "material",
          "currency",
          "other"
        ]
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "别名表：编纂员把正文出现的异名（残篇/残卷）归一化到本条目"
      },
      "state": {
        "type": "string",
        "description": "当前状态（如 完整/残篇/圆满），可与 name 配合；缺省表示无状态维度"
      },
      "desc": {
        "type": "string",
        "description": "物品描述（可在生成上下文注入；note 为其一句话别名，二者并存）"
      },
      "note": {
        "type": "string",
        "description": "一句话说明（可注入生成上下文）"
      }
    },
    "additionalProperties": false
  }
}
