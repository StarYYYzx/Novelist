{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelist.dev/schemas/bible/plot_threads.schema.json",
  "title": "plot_threads",
  "description": "伏笔登记与回收（单一事实源）。见 docs/06 §3.2。第九批：加 scope/target_vol（卷级收尾工作流判定输入）；status 补 active/paid_off（与代码实际流转 planted→active→paid_off 对齐）。 F0': 根节点修正为数组（磁盘实然，docs/06 §3 数组形态）。",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "desc",
      "status"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(pt|thread):[A-Za-z0-9_-]+$"
      },
      "desc": {
        "type": "string",
        "minLength": 1
      },
      "plant_desc": {
        "type": "string",
        "minLength": 1,
        "description": "埋设方式一句话（thread_set 节点协议产出，F5 修订：原白名单过滤丢弃导致伏笔语义丢失，改为 schema 收录）。"
      },
      "payoff_desc": {
        "type": "string",
        "minLength": 1,
        "description": "回收方式一句话（thread_set 节点协议产出；roll 的 payoff_checklist / V5 伏笔密度检查消费）。"
      },
      "scope": {
        "type": "string",
        "enum": [
          "volume",
          "book"
        ],
        "description": "volume=卷内线（默认，须在 target_vol 卷末回收）；book=全书主线跨卷。缺省按 volume 处理。"
      },
      "target_vol": {
        "type": "integer",
        "minimum": 1,
        "description": "本线应在第几卷回收；缺省取 planted.vol。"
      },
      "planted": {
        "type": "object",
        "required": [
          "vol",
          "ch"
        ],
        "properties": {
          "vol": {
            "type": "integer",
            "minimum": 1
          },
          "ch": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "status": {
        "enum": [
          "unplanned",
          "planted",
          "active",
          "paid_off",
          "pending_return",
          "returned"
        ]
      },
      "report_deadline": {
        "type": "object",
        "required": [
          "vol",
          "ch"
        ],
        "properties": {
          "vol": {
            "type": "integer",
            "minimum": 1
          },
          "ch": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "returned": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "vol": {
            "type": "integer",
            "minimum": 1
          },
          "ch": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "revision": {
        "type": "integer",
        "minimum": 0
      },
      "carrier": {
        "enum": [
          "object",
          "goal",
          "character",
          "emotion",
          "faction",
          "theme"
        ],
        "description": "伏笔载体（ADR-025 批2）：回收后载体预期持续出场时登记，卷末审计据此提名升级为线（ln:xxx）。"
      },
      "due": {
        "type": "string",
        "description": "卷末审计写回的到期强制处理项（target_vol 已到未回收）；回收/改期后由审计清除。"
      }
    },
    "additionalProperties": false
  }
}
