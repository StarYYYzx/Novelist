{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelist.dev/schemas/project.schema.json",
  "title": "project_meta",
  "description": "project.json（项目元数据 + 流水线状态 + 批基线元信息）。见 docs/06 §2/§4.5/§6。 F0': id 模式放宽（project_id 即目录名 proj-t5，无 proj: 前缀）。",
  "type": "object",
  "required": [
    "id",
    "title",
    "pipeline_state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^proj[A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "string"
    },
    "genre": {
      "type": [
        "string",
        "null"
      ]
    },
    "prefs": {
      "type": "object",
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": true
    },
    "pipeline_state": {
      "type": "string",
      "enum": [
        "立项",
        "世界观",
        "大纲",
        "细纲",
        "正文",
        "审查",
        "待发布",
        "已完成"
      ]
    },
    "event_seq": {
      "type": "integer",
      "minimum": 0
    },
    "forge": {
      "type": "object",
      "description": "构建层 Forge 状态（docs/10 §4.1）：输入模式 / 交互形态 / 阶段 / 蓝图修订 / 调用预算 / 进度",
      "properties": {
        "mode": {
          "enum": [
            "seed",
            "ingest"
          ],
          "description": "输入模式"
        },
        "interaction": {
          "enum": [
            "auto",
            "interactive"
          ],
          "description": "全权 / 商讨"
        },
        "stage": {
          "enum": [
            "slots",
            "ask",
            "seed",
            "consulting",
            "seeded",
            "build",
            "built",
            "review",
            "validate",
            "done",
            "ingest",
            "ingested"
          ],
          "description": "Forge 阶段（F5 起对齐实然；2026-09-19 D-11 补 review——闸门暂停态，engine build finally 会写入）"
        },
        "blueprint_rev": {
          "type": "integer",
          "minimum": 1
        },
        "calls_used": {
          "type": "integer",
          "minimum": 0
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO8601 起始时间"
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": true,
  "$comment": "pipeline_state 取值与 docs/06 §4.1 对齐；event_seq 为事件回写序列计数；forge 段为构建层状态（docs/10 §4.1）"
}
