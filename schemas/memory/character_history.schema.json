{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelist.dev/schemas/memory/character_history.schema.json",
  "title": "character_history",
  "description": "人物经历史（记忆层·事实演进·实然）。见 docs/06 §3.5。",
  "type": "object",
  "required": [
    "char_id",
    "revision",
    "entries"
  ],
  "properties": {
    "char_id": {
      "type": "string",
      "pattern": "^(char:|char_)[A-Za-z0-9_-]+$",
      "description": "人物稳定 ID。新数据统一 char: 前缀；旧数据 char_ 前缀兼容（历史项目）。"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "summary"
        ],
        "properties": {
          "at": {
            "type": "object",
            "required": [
              "vol",
              "ch"
            ],
            "properties": {
              "vol": {
                "type": "integer",
                "minimum": 1
              },
              "ch": {
                "type": "integer",
                "minimum": 1
              },
              "t": {
                "type": "integer",
                "minimum": 0,
                "description": "故事内相对天数（ADR-019 时间轴，chronicler 章末/视角条目携带）"
              }
            },
            "additionalProperties": false
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "state_delta": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "power": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "emotion": {
            "type": [
              "string",
              "null"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hash": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "ADR-020 N4 视角记忆条目标记（perspective）；普通经历条目缺省"
          },
          "stance": {
            "type": "string",
            "description": "N4 该角色对本事件的立场/情绪"
          },
          "perspective": {
            "type": "string",
            "description": "N4 该角色视角的事件概述（160 字内）"
          },
          "relations": {
            "type": "array",
            "description": "N4 事件中涉及的关系变化。字符串 = 旧格式；对象 {who, delta} = ADR-020 N4 结构化格式（chronicler 视角条目实然，schema 此前漏更致 V1 误报）。",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "who",
                    "delta"
                  ],
                  "properties": {
                    "who": {
                      "type": "string",
                      "pattern": "^(char:|char_)[A-Za-z0-9_-]+$",
                      "description": "关系对象的人物稳定 ID"
                    },
                    "delta": {
                      "type": "string",
                      "description": "一句话关系变化（如 升温·隐约察觉他的在意）"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "event_ref": {
            "type": "string",
            "description": "N4 回指 plot_events 的事件 id（支撑按需重读章节）"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
