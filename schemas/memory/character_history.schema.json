{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelist.dev/schemas/memory/character_history.schema.json",
  "title": "character_history",
  "description": "人物经历史（记忆层·事实演进·实然）。见 docs/06 §3.5。",
  "type": "object",
  "required": ["char_id", "revision", "entries"],
  "properties": {
    "char_id": { "type": "string", "pattern": "^char:[A-Za-z0-9_-]+$" },
    "revision": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "summary"],
        "properties": {
          "at": {
            "type": "object",
            "required": ["vol", "ch"],
            "properties": { "vol": { "type": "integer", "minimum": 1 }, "ch": { "type": "integer", "minimum": 1 } },
            "additionalProperties": false
          },
          "summary": { "type": "string", "minLength": 1 },
          "state_delta": {
            "type": "object",
            "properties": {
              "power": { "type": "string" },
              "status": { "type": "string" }
            },
            "additionalProperties": true
          },
          "emotion": { "type": ["string", "null"] },
          "refs": { "type": "array", "items": { "type": "string" } },
          "hash": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
